{
    "name": "文献调研智能体 (Literature Survey Agent)",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "pip install -r requirements.txt",
    "postStartCommand": "nohup uvicorn app:app --host 0.0.0.0 --port 8765 > /tmp/lit-agent.log 2>&1 &",
    "forwardPorts": [8765],
    "portsAttributes": {
        "8765": {
            "label": "Literature Agent",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python"]
        }
    }
}
